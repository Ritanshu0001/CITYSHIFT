# Python
.venv/
__pycache__/
*.pyc

# OSMnx raw HTTP cache (large). The app cache in cache/ IS committed on purpose.
osmnx_cache/
backend/osmnx_cache/

# Open-Meteo raw responses (weather, elevation): rebuildable, and quota-costly to rebuild.
backend/openmeteo_cache/

# Raw downloads (FARS zips etc.). Slim extracts that the app needs live in backend/data/.
backend/raw_data/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Secrets
.env
.env*.local

# OS
.DS_Store
Thumbs.db

# Local team contracts and plans stay out of git.
# Exception: CHANGE_REQUESTS.md is tracked so the CR log has one shared history
# instead of being passed between P1, P2 and P3 by hand. Directory-style
# '/contracts/' would stop git descending, so the contents are excluded with a
# wildcard and that one file is re-included.
/contracts/*
!/contracts/CHANGE_REQUESTS.md
/plans/
