# Copy to .env in the repository root. Both apps load this file automatically.
# Browser key for Maps, Places and Street View.
GOOGLE_MAPS_KEY=

# Server-only Gemini settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend and API proxy.
NEXT_PUBLIC_API_BASE=/api/backend
NEXT_PUBLIC_USE_MOCK=0
NEXT_PUBLIC_USE_CHAT_MOCK=0
CITYSHIFT_BACKEND_URL=http://127.0.0.1:8000

# Optional backend settings (shell variables can also override these).
# LOG_LEVEL=INFO
# CITYSHIFT_OVERPASS_URLS=https://overpass-api.de/api,https://overpass.private.coffee/api
